# Copy to .env.local (gitignored) and source before any gcloud/terraform work.
# These are identifiers, not secrets. The credential-shaped values are the exceptions, noted below.

# --- Berlin universe (pre-GA staging names: expect these to change at GA) ---
export UNIVERSE_NAME="berlin"
export UNIVERSE_WEB_DOMAIN="cloud.berlin-build0.goog"
export UNIVERSE_API_DOMAIN="apis-berlin-build0.goog"
export UNIVERSE_IDENTITY_DOMAIN="id-berlin-build0.goog"   # federated identities are @ this domain
export UNIVERSE_PREFIX="eu0"
export UNIVERSE_REGION="u-germany-northeast1"

# --- Identity: Workforce Identity Federation only. No Google Accounts in GCD. ---
export ORG_ID="preview-soloio"
export WORKFORCE_POOL="preview-soloio-p"
export WORKFORCE_PROVIDER="preview-soloio-pp"

# Shared org account, not a personal identity. Confirmed in console 2026-09-03.
# Subject value is UNVERIFIED: confirm with `gcloud auth list` before using a
# principal:// binding, the console may show a mapped display name not the raw subject.
export WORKFORCE_ACCOUNT="preview-soloio@id-berlin-build0.goog"

# Written by `gcloud iam workforce-pools create-login-config`. Credential-shaped: gitignored.
export WIF_LOGIN_CONFIG="${HOME}/.config/gcloud/wif-login-config-berlin.json"

# --- Project. Note the mandatory universe prefix and the colon. ---
export PROJECT_SHORT="soloio-eval"
export PROJECT_ID="${UNIVERSE_PREFIX}:${PROJECT_SHORT}"
export BILLING_ACCOUNT=""

# --- In-universe Artifact Registry ---
# Standard-mode repos only. No remote/virtual repos, so no pull-through mirror:
# every image has to be pushed explicitly (scripts/mirror-images.sh).
#
# The AR domain is pkg-berlin-build0.goog -- it replaces pkg.dev. The
# "<region>-docker" prefix below is the PUBLIC-GCP convention and is NOT
# confirmed for Berlin, so treat AR_HOST as a starting guess and verify:
#   gcloud artifacts repositories describe "${AR_REPO}" \
#     --location="${AR_LOCATION}" --format='value(registryUri)'
export AR_LOCATION="${UNIVERSE_REGION}"
export AR_REPO="solo"
export AR_HOST="docker.pkg-berlin-build0.goog"   # CONFIRMED from registryUri 2026-09-03

# AR_PREFIX uses PROJECT_SHORT, *not* PROJECT_ID. This is not a style choice.
# A colon is not legal inside a docker reference path component, so
# ${AR_HOST}/eu0:soloio-eval/... is rejected by docker, containerd, crane and
# Helm's OCI client with "invalid reference format" before any network call is
# made. Confirmed 2026-09-03.
#   evidence: feedback/google/evidence/berlin-eu0-colon-docker-ref-2026-09-03.txt
#   finding:  feedback/google/02-eu0-prefix-breaks-container-references.md
# Still open: whether AR routes the unprefixed form to eu0:soloio-eval.
export AR_PREFIX="${AR_HOST}/${UNIVERSE_PREFIX}/${PROJECT_SHORT}/${AR_REPO}"

# --- Secrets. Never commit real values. ---
export AGENTGATEWAY_LICENSE_KEY=""
export ISTIO_LICENSE_KEY=""

# Google's Berlin GCD doc set. Gated by a request header, not a login.
# In a browser, set X-DevSite-Proxy: gcd with the ModHeader extension.
GCD_DOCS_HOST="berlin.devsitetest.how"
GCD_DOCS_HEADER="X-DevSite-Proxy: gcd"

# Project NUMBER, not id. Service agent emails carry the number.
# In this universe it is near-identical to the org number, so check it.
export PROJECT_NUMBER=REPLACE-ME

# Must match cluster_name in the active infra/tofu profile.
export CLUSTER_NAME=agentic
