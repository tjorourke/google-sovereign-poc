# Pinned versions for poc/2026-10-kagent-substrate. Sourced by scripts/lib.sh.
#
# kagent 1.0 runs every agent as an Agent Substrate actor inside a gVisor
# sandbox. A kagent release pins its Substrate version (go/go.mod in the kagent
# repo); the two must move together, and so must the Autopilot allowlists,
# which pin the atelet and worker images by tag.

# kagent OSS. kagent-enterprise is still on 0.5.x and has no Substrate runtime.
KAGENT_VERSION=1.0.0-alpha16
# Pinned by KAGENT_VERSION: github.com/kagent-dev/kagent/blob/v1.0.0-alpha16/go/go.mod
SUBSTRATE_VERSION=0.6.0-alpha3

# Solo Enterprise for agentgateway. The previous lab ran v2026.9.3.
AGW_ENT_VERSION=v2026.10.0
AGW_CHART_BASE=oci://us-docker.pkg.dev/solo-public/enterprise-agentgateway/charts
GATEWAY_API_VERSION=v1.6.1

# Berlin offers nothing newer than this (RAPID default, 2026-10-21). 1.37 would
# serve the certificate APIs as GA and need no beta enablement.
GKE_VERSION=1.36.4-gke.1391000

# No GPUs: agents reach OpenAI through agentgateway, over Cloud NAT.
OPENAI_MODEL=gpt-4.1-mini

# Standalone sandbox guest (kagent supplies the entrypoint; digest required).
SANDBOX_GUEST_IMAGE=ghcr.io/kagent-dev/kagent/sandbox-guest@sha256:d3c444e3f5472598ff520255b72cfcb9ecdf22815fd87747315aeaf0520801c3

# Allowlist object paths. Each must be listed EXACTLY in the org policy and in
# the cluster's autopilot_privileged_admission (infra/tofu profile).
ALLOWLIST_BUCKET=agentic-allowlist
ALLOWLIST_PREFIX=substrate/0.6.0-alpha3
